---
import type { ImageMetadata, MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { GallerySlide } from '@/lib/gallery';
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ProjectHero from '@/components/projects/ProjectHero.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import siteConfig from '@/config/site.config';
import { getProjectOgPath } from '@/lib/og';
import { t, getLocaleFromPath, localizedPath, getLocales } from '@/i18n';
import {
  getProjectSlug,
  getProjectUrl,
  getProjectsBaseUrl,
  getProjectTranslations,
} from '@/lib/projects';

interface Props {
  title: string;
  description: string;
  meta?: string[];
  url?: string;
  repo?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  gallery?: GallerySlide[];
  tags?: string[];
  /** Project slug, used to resolve the per-project dynamic OG image. */
  slug?: string;
  related?: CollectionEntry<'projects'>[];
  headings?: MarkdownHeading[];
  /** Per-project override: hide table of contents on this project */
  toc?: boolean;
}

const {
  title,
  description,
  meta = [],
  url,
  repo,
  image,
  imageAlt,
  gallery = [],
  tags = [],
  slug = '',
  related = [],
  headings = [],
  toc: tocOverride,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);

// Prefer the project's own image; otherwise serve the per-project dynamic OG
// image (see src/pages/og/projects/[slug].svg.ts). `slug` is the full
// (locale-prefixed) project id, so strip the locale to match the OG route.
const ogImage =
  image?.src || (slug ? getProjectOgPath(getProjectSlug(slug, locale)) : siteConfig.ogImage);

// Mirror the blog TOC wiring — projects use the same site-wide config.
const tocConfig = siteConfig.articleFeatures?.toc;
const showToc = !!tocConfig?.enabled && tocOverride !== false;
const tocLayout = tocConfig?.layout ?? 'auto';
const sidebarActive = showToc && (tocLayout === 'sidebar' || tocLayout === 'auto');
// Inline TOC is now opt-in: 'auto' shows only the desktop sidebar so the
// mobile/landscape/tablet experience isn't dominated by a TOC card the
// majority of visitors don't use. Posts that want the inline TOC visible
// everywhere can set `toc.layout: 'inline'` in frontmatter.
const inlineActive = showToc && tocLayout === 'inline';
const sidebarOnLeft = (tocConfig?.sidebarPosition ?? 'right') === 'left';

const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: t('projects.title', locale), href: getProjectsBaseUrl(locale) },
  { label: title },
];

const projectsHref = getProjectsBaseUrl(locale);
const contactUrl = localizedPath('/contact', locale);

// Resolve this project's real per-locale URLs so the hreflang tags and the
// LanguageSwitcher point at the matching translation. Projects share one slug
// across locales, so unlike the blog (which uses canonical uids) matching the
// locale-stripped slug is enough. hreflang lists only verified translations;
// the switcher shows every locale, falling back to a locale's projects index
// when this project has no translation there, so switching never 404s.
const projectTranslations = await getProjectTranslations(getProjectSlug(slug, locale), locale);
const translationByLocale = new Map(projectTranslations.map((tr) => [tr.locale, tr.url]));
const languageAlternates = Object.fromEntries(
  getLocales().map((loc) => [loc, translationByLocale.get(loc) ?? getProjectsBaseUrl(loc)])
);
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={imageAlt || title}
  localeAlternates={projectTranslations}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={false}
    showScrollProgress
    maxWidth="7xl"
    languageAlternates={languageAlternates}
  />

  <div class="min-h-screen pt-16">
    <ProjectHero
      title={title}
      description={description}
      meta={meta}
      url={url}
      repo={repo}
      image={image}
      imageAlt={imageAlt}
      gallery={gallery}
      tags={tags}
    />

    <article class="pt-8 pb-(--space-section-md)">
      <div
        class:list={[
          'mx-auto max-w-7xl px-6',
          sidebarActive &&
            (sidebarOnLeft
              ? 'xl:grid xl:grid-cols-[15rem_minmax(0,1fr)] xl:gap-10'
              : 'xl:grid xl:grid-cols-[minmax(0,1fr)_15rem] xl:gap-10'),
        ]}
      >
        {
          sidebarActive && sidebarOnLeft && (
            <aside class="hidden xl:block" aria-label={t('blog.tableOfContents', locale)}>
              <TableOfContents
                headings={headings}
                maxDepth={tocConfig?.maxDepth ?? 3}
                minHeadings={tocConfig?.minHeadings ?? 3}
                sticky
              />
            </aside>
          )
        }

        <div class:list={['mx-auto w-full max-w-4xl min-w-0', sidebarActive && 'xl:mx-0']}>
          <Breadcrumbs items={breadcrumbs} class="mb-8" />

          {
            sidebarActive && (
              <div class="mb-10 xl:hidden">
                <TableOfContents
                  headings={headings}
                  maxDepth={tocConfig?.maxDepth ?? 3}
                  minHeadings={tocConfig?.minHeadings ?? 3}
                  collapsible
                />
              </div>
            )
          }

          {
            inlineActive && (
              <div class="border-border bg-background-secondary mb-10 rounded-xl border p-5">
                <TableOfContents
                  headings={headings}
                  maxDepth={tocConfig?.maxDepth ?? 3}
                  minHeadings={tocConfig?.minHeadings ?? 3}
                />
              </div>
            )
          }

          <div class="prose prose-lg max-w-none" data-reveal-content>
            <slot />
          </div>

          <footer class="border-border mt-12 flex justify-center border-t pt-8" data-reveal>
            <Button href={projectsHref} variant="brand-outline" size="sm">
              <Icon name="arrow-left" size="sm" />
              {t('projects.backToProjects', locale)}
            </Button>
          </footer>
        </div>

        {
          sidebarActive && !sidebarOnLeft && (
            <aside class="hidden xl:block" aria-label={t('blog.tableOfContents', locale)}>
              <TableOfContents
                headings={headings}
                maxDepth={tocConfig?.maxDepth ?? 3}
                minHeadings={tocConfig?.minHeadings ?? 3}
                sticky
              />
            </aside>
          )
        }
      </div>
    </article>

    {
      related.length > 0 && (
        <section
          class="bg-background-secondary border-border border-t py-(--space-section-md)"
          data-reveal
        >
          <div class="mx-auto max-w-7xl px-6">
            <h2 class="font-display text-foreground mb-8 text-center text-2xl font-bold md:text-3xl">
              {t('projects.moreProjects', locale)}
            </h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((project) => (
                <Card
                  variant="elevated"
                  hover
                  padding="none"
                  href={project.data.placeholder ? undefined : getProjectUrl(project.id, locale)}
                  class="group flex flex-col"
                >
                  <div class="flex flex-1 flex-col p-6">
                    <div class="mb-3 flex items-start justify-between gap-4">
                      <div class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-linear-to-br">
                        <Icon name="layers" size="sm" />
                      </div>
                      <Icon
                        name="arrow-up-right"
                        size="sm"
                        class="text-foreground-muted group-hover:text-brand-500 ml-auto shrink-0 transition-colors"
                      />
                    </div>
                    <div class="mb-2 flex items-baseline gap-2">
                      <h3 class="font-display text-foreground text-lg font-bold">
                        {project.data.title}
                      </h3>
                      {project.data.year && (
                        <span class="text-foreground-muted text-xs">{project.data.year}</span>
                      )}
                    </div>
                    <p class="text-foreground-muted mb-4 line-clamp-3 flex-1 text-sm leading-relaxed">
                      {project.data.description}
                    </p>
                    {project.data.tags && project.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5">
                        {project.data.tags.map((tag, i) => (
                          <>
                            {i === 3 && <div class="basis-full" aria-hidden="true" />}
                            <span class="text-brand-700 dark:text-brand-400 ring-brand-500/40 group-hover:ring-brand-500/80 inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium ring-1 transition-colors ring-inset">
                              #{tag}
                            </span>
                          </>
                        ))}
                      </div>
                    )}
                  </div>
                </Card>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Closing CTA -->
    <section class="bg-background border-border relative z-10 border-t py-(--space-section-md)">
      <!-- Mobile: flat section, no glitch band -->
      <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
        <Badge variant="brand" pill class="mb-6">
          <Icon name="message-circle" size="sm" />
          {t('projects.ctaBadge', locale)}
        </Badge>
        <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
          {t('projects.closingHeading', locale)}
        </h2>
        <p class="text-foreground-muted mb-8 text-lg text-balance">
          {t('projects.closingLead', locale)}
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <Button size="lg" href={contactUrl} class="cta-btn-brand">
            {t('projects.ctaPrimary', locale)}
            <Icon name="arrow-right" size="sm" />
          </Button>
          <Button size="lg" variant="brand-outline" href={projectsHref}>
            {t('projects.allProjects', locale)}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>

      <!-- Desktop: LetterGlitch band with glass card -->
      <LetterGlitchBand maxWidth="7xl">
        <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
          {t('projects.closingHeading', locale)}
        </h2>
        <p class="text-foreground-muted mb-8 text-lg text-balance">
          {t('projects.closingLead', locale)}
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <Button size="lg" href={contactUrl} class="hero-btn-brand">
            {t('projects.ctaPrimary', locale)}
            <Icon name="arrow-right" size="sm" />
          </Button>
          <Button size="lg" variant="outline" href={projectsHref}>
            {t('projects.allProjects', locale)}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </LetterGlitchBand>
    </section>
  </div>

  <Footer slot="footer" layout="centered" background="secondary" maxWidth="7xl" />
</BaseLayout>
