---
/**
 * Project listing card. Extracted so the projects index, paginated pages,
 * and tag archives render identical cards from one source of truth.
 *
 * Placeholder projects render as a non-interactive card (no link), matching
 * how the listing treats projects that don't have their own detail page.
 */
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { defaultLocale } from '@/i18n';
import { getProjectUrl } from '@/lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Stagger index for the scroll-reveal cascade. */
  index?: number;
  /**
   * Locale the card's link belongs to. Default-locale links stay at
   * `/projects/...`; other locales are prefixed (`/<locale>/projects/...`).
   */
  locale?: string;
}

const { project, index = 0, locale = defaultLocale } = Astro.props;
const { data } = project;
---

<Card
  variant="elevated"
  hover
  padding="none"
  href={data.placeholder ? undefined : getProjectUrl(project.id, locale)}
  class="group flex flex-col"
  data-reveal
  data-reveal-delay={index % 2 || undefined}
>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-start justify-between gap-4">
      <div
        class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-linear-to-br"
      >
        <Icon name="layers" size="sm" />
      </div>
      <Icon
        name="arrow-up-right"
        size="sm"
        class="text-foreground-muted group-hover:text-brand-500 ml-auto shrink-0 transition-colors"
      />
    </div>
    <div class="mb-2 flex items-baseline gap-2">
      <h3 class="font-display text-foreground text-lg font-bold">{data.title}</h3>
      {data.year && <span class="text-foreground-muted text-xs">{data.year}</span>}
    </div>
    <p class="text-foreground-muted mb-4 flex-1 text-sm leading-relaxed">{data.description}</p>
    {
      data.tags && data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {data.tags.map((tag) => (
            <span class="text-brand-700 dark:text-brand-400 ring-brand-500/40 group-hover:ring-brand-500/80 inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium ring-1 transition-colors ring-inset">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</Card>
